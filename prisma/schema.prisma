generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  weeklyGoal   Int      @default(4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workouts            Workout[]
  routineDays         RoutineDay[]
  sentRequests        Friendship[]   @relation("requester")
  receivedRequests    Friendship[]   @relation("addressee")
  taggedInWorkouts    WorkoutBuddy[] @relation("buddyUser")
  fistBumps           WorkoutFistBump[]
  comments            WorkoutComment[]

  @@index([username])
  @@index([email])
}

model Workout {
  id        String   @id @default(cuid())
  userId    String
  date      String   // ISO date string YYYY-MM-DD to avoid timezone issues
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscleGroups WorkoutMuscleGroup[]
  buddies      WorkoutBuddy[]
  fistBumps    WorkoutFistBump[]
  comments     WorkoutComment[]

  @@index([userId])
  @@index([date])
  @@index([userId, date])
}

model WorkoutBuddy {
  id        String   @id @default(cuid())
  workoutId String
  userId    String
  createdAt DateTime @default(now())

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  user    User    @relation("buddyUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workoutId, userId])
  @@index([workoutId])
  @@index([userId])
}

model WorkoutMuscleGroup {
  id          String @id @default(cuid())
  workoutId   String
  muscleGroup String // enum-like: CHEST, BACK, SHOULDERS, BICEPS, TRICEPS, LEGS, ABS, CARDIO, OTHER

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([workoutId])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
}

model RoutineDay {
  id           String   @id @default(cuid())
  userId       String
  dayOfWeek    Int      // 1: Monday, 2: Tuesday, ..., 7: Sunday
  isRestDay    Boolean  @default(false)
  title        String?  // e.g. "Push", "Göğüs + Kol", "Dinlenme"
  muscleGroups String   @default("") // Comma-separated enum strings: "CHEST,TRICEPS"
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek])
  @@index([userId])
}

model WorkoutFistBump {
  id        String   @id @default(cuid())
  workoutId String
  userId    String
  createdAt DateTime @default(now())

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workoutId, userId])
  @@index([workoutId])
  @@index([userId])
}

model WorkoutComment {
  id        String   @id @default(cuid())
  workoutId String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workoutId])
  @@index([userId])
}


